---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { NAV, SITE } from '@/data/site';
import { NAV_SERVICES } from '@/data/services';
import { buttonVariants } from '@/components/ui/button';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const serviceLinks = NAV_SERVICES.map((service) => ({
  label: service.name,
  href: `/services/${service.slug}`,
}));
---

<header class="sticky top-0 z-50 border-b border-border bg-background/92 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-3">
    <a href="/" class="shrink-0" aria-label={`${SITE.name} home`}>
      <img
        src="/images/logo.png"
        alt={SITE.name}
        width="240"
        height="100"
        class="logo-light h-[50px] w-[120px]"
      />
      <img
        src="/images/logo-white.png"
        alt={SITE.name}
        width="240"
        height="100"
        class="logo-dark h-[50px] w-[120px]"
      />
    </a>

    <div class="hidden items-center gap-7 lg:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-[0.9375rem] font-medium transition-colors',
              isActive(item.href) ? 'text-primary' : 'text-foreground hover:text-primary',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
      <a
        href={SITE.bookingUrl}
        target="_blank"
        rel="noopener"
        class={buttonVariants({ size: 'sm' })}
      >
        Book Now
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:border-primary hover:text-primary"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div class="hidden border-t border-hairline bg-surface lg:block">
    <ul class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-7 gap-y-1 px-6 py-2">
      {
        serviceLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors',
                isActive(link.href)
                  ? 'text-primary'
                  : 'text-muted-foreground hover:text-primary',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {
    SITE.announcement && (
      <a
        href={SITE.announcement.href}
        class="block bg-announcement px-6 py-2.5 text-center text-sm font-medium text-announcement-foreground underline-offset-4 transition-opacity hover:underline hover:opacity-90"
      >
        {SITE.announcement.text}
      </a>
    )
  }
</header>

<!-- Sibling of the header, not a child: a fixed full-screen layer inside the
     header's backdrop-filter forces mobile Safari to re-blur the whole page on
     every frame of the open/close fade, which can lock up the browser. -->
<div class="mobile-menu-overlay lg:hidden" id="mobile-menu" data-open="false">
  <button
    type="button"
    id="nav-close"
    class="absolute right-5 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground transition-colors hover:border-primary hover:text-primary"
    aria-label="Close menu"
  >
    <svg
      class="h-6 w-6"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
  <div class="flex flex-1 flex-col">
    <ul class="border-y border-hairline">
      {
        NAV.map((item) => (
          <li class="border-b border-hairline last:border-b-0">
            <a href={item.href} class="block px-6 py-4 text-2xl font-medium">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="border-b border-hairline bg-surface">
      {
        serviceLinks.map((link) => (
          <li class="border-b border-hairline last:border-b-0">
            <a
              href={link.href}
              class="block px-6 py-3 font-medium text-muted-foreground"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-auto space-y-3 px-6 pt-8">
      <a
        href={SITE.bookingUrl}
        target="_blank"
        rel="noopener"
        class={buttonVariants({ size: 'lg', className: 'w-full' })}
      >
        Book Now
      </a>
      <a
        href={SITE.phoneHref}
        class={buttonVariants({ variant: 'secondary', size: 'lg', className: 'w-full' })}
      >
        {SITE.phone}
      </a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const close = document.getElementById('nav-close');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    menu?.setAttribute('data-open', String(open));
    toggle?.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('nav-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
