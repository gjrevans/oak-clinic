---
import { buttonVariants } from '@/components/ui/button';
import { SITE } from '@/data/site';
import type { Person } from '@/data/types';

interface Props {
  person: Person;
  /** `card` for grids, `row` for the team page's alternating full-width rows. */
  variant?: 'card' | 'row';
  /** Row variant only: odd indexes put the portrait on the right. */
  index?: number;
  class?: string;
}

const { person, variant = 'card', index = 0, class: className } = Astro.props;

const portrait = person.thumbnailImage ?? person.mainImage;
const profileHref = `/people/${person.slug}`;
// Practitioners who have stopped taking new patients carry a note instead of
// a booking button; the note names whoever is covering for them.
const bookingHref = person.bookingLink || SITE.bookingUrl;
const showBooking = person.bookable;
const note = !showBooking && person.bookingText ? person.bookingText : undefined;
const portraitAlt = portrait?.alt || person.name;
const flip = index % 2 === 1;
---

{
  variant === 'card' ? (
    <article
      class:list={[
        'group flex h-full flex-col overflow-hidden rounded-lg border border-hairline bg-card transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-foreground/5',
        className,
      ]}
    >
      {portrait && (
        <a href={profileHref} class="block overflow-hidden bg-surface">
          <img
            src={portrait.src}
            alt={portraitAlt}
            width={portrait.width}
            height={portrait.height}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
        </a>
      )}
      <div class="flex flex-1 flex-col p-6">
        <h3 class="text-xl">
          <a href={profileHref} class="transition-colors hover:text-primary">
            {person.name}
          </a>
        </h3>
        <p class="mt-1 text-sm font-medium text-primary">{person.title}</p>
        {person.summary && (
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted-foreground">
            {person.summary}
          </p>
        )}
        <div class="mt-auto flex flex-col gap-2.5 pt-6">
          <a
            href={profileHref}
            class={buttonVariants({ variant: 'secondary', className: 'w-full' })}
          >
            View Profile
          </a>
          {showBooking && (
            <a
              href={bookingHref}
              target="_blank"
              rel="noopener"
              class={buttonVariants({ className: 'w-full' })}
            >
              Book Now
            </a>
          )}
          {note && <div class="prose-oak text-sm" set:html={note} />}
        </div>
      </div>
    </article>
  ) : (
    <article
      class:list={[
        'grid items-center gap-8 md:grid-cols-2 md:gap-12 lg:gap-16',
        className,
      ]}
    >
      {portrait && (
        <a
          href={profileHref}
          class:list={[
            'oak-frame group block self-start border border-hairline bg-surface',
            flip && 'md:order-2',
          ]}
        >
          <img
            src={portrait.src}
            alt={portraitAlt}
            width={portrait.width}
            height={portrait.height}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </a>
      )}
      <div>
        <h3 class="text-2xl md:text-3xl">
          <a href={profileHref} class="transition-colors hover:text-primary">
            {person.name}
          </a>
        </h3>
        <p class="mt-2 text-sm font-medium tracking-wide text-primary">{person.title}</p>
        {person.summary && (
          <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{person.summary}</p>
        )}
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={profileHref} class={buttonVariants({ variant: 'secondary' })}>
            View Profile
          </a>
          {showBooking && (
            <a href={bookingHref} target="_blank" rel="noopener" class={buttonVariants()}>
              Book Now
            </a>
          )}
        </div>
        {note && <div class="prose-oak mt-5 max-w-prose text-sm" set:html={note} />}
      </div>
    </article>
  )
}
