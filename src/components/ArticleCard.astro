---
import { formatDate, type Article } from '@/lib/articles';
import type { Person } from '@/data/types';

interface Props {
  article: Article;
  author?: Person;
  class?: string;
}

const { article, author, class: className } = Astro.props;
const { title, slug, summary, publishedOn } = article.data;
const image = article.data.thumbnail ?? article.data.mainImage;
const avatar = author?.avatar ?? author?.thumbnailImage;
---

<article
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-2xl border border-hairline bg-card transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-foreground/5',
    className,
  ]}
>
  {
    author && (
      <div class="flex items-center gap-3 px-5 pt-5">
        {avatar && (
          <img
            src={avatar.src}
            alt={author.name}
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            class="h-10 w-10 shrink-0 rounded-full object-cover"
          />
        )}
        <div class="min-w-0">
          <a
            href={`/people/${author.slug}`}
            class="block truncate text-sm font-medium transition-colors hover:text-primary"
          >
            {author.name}
          </a>
          <time datetime={publishedOn.toISOString()} class="text-xs text-muted-foreground">
            {formatDate(publishedOn)}
          </time>
        </div>
      </div>
    )
  }

  {
    image && (
      <a href={`/articles/${slug}`} class="mt-5 block aspect-[3/2] overflow-hidden bg-surface">
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </a>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg">
      <a href={`/articles/${slug}`} class="transition-colors hover:text-primary">{title}</a>
    </h3>
    {
      summary && (
        <p class="mt-3 line-clamp-4 text-sm leading-relaxed text-muted-foreground">{summary}</p>
      )
    }
  </div>
</article>
