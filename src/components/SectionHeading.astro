---
interface Props {
  title: string;
  lede?: string;
  class?: string;
}

const { title, lede, class: className } = Astro.props;
---

<div class:list={['mx-auto max-w-3xl text-center', className]}>
  <h2 class="text-3xl md:text-4xl">{title}</h2>
  {
    lede && (
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{lede}</p>
    )
  }
</div>
