---
import { buttonVariants } from '@/components/ui/button';
import { SITE } from '@/data/site';
import type { Discipline } from '@/data/types';

interface Props {
  disciplines: Discipline[];
  /** The live site opens nothing on load; the flag is here for reuse. */
  openFirst?: boolean;
  class?: string;
}

const { disciplines, openFirst = false, class: className } = Astro.props;
---

<div
  class:list={[
    'divide-y divide-hairline overflow-hidden rounded-2xl border border-hairline bg-card',
    className,
  ]}
>
  {
    disciplines.map((discipline, i) => (
      <details class="accordion-row group" open={openFirst && i === 0}>
        <summary class="flex cursor-pointer list-none items-center gap-4 p-5 transition-colors hover:bg-surface md:gap-5 md:p-6 [&::-webkit-details-marker]:hidden">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-accent">
            {discipline.icon ? (
              <img
                src={discipline.icon.src}
                alt=""
                width={discipline.icon.width}
                height={discipline.icon.height}
                loading="lazy"
                decoding="async"
                class="size-7"
              />
            ) : (
              <span class="size-3 rounded-full bg-accent-foreground" aria-hidden="true" />
            )}
          </span>
          <h3 class="flex-1 text-lg md:text-xl">{discipline.name}</h3>
          <svg
            class="size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="px-5 pb-6 md:px-6 md:pb-8 md:pl-[6.25rem]">
          <div class="prose-oak max-w-3xl" set:html={discipline.description} />
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={discipline.bookingLink || SITE.bookingUrl}
              target="_blank"
              rel="noopener"
              class={buttonVariants({ size: 'sm' })}
            >
              Book Now
            </a>
            <a
              href={`/disciplines/${discipline.slug}`}
              class={buttonVariants({ variant: 'secondary', size: 'sm' })}
            >
              Learn More
            </a>
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  /* Native disclosure, no script. Browsers with `::details-content` ease the
     panel open; the rest simply snap, which is the Webflow behaviour anyway. */
  .accordion-row {
    interpolate-size: allow-keywords;
  }

  .accordion-row::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.28s ease,
      content-visibility 0.28s ease allow-discrete;
  }

  .accordion-row[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-row::details-content {
      transition: none;
    }
  }
</style>
