---
import { SITE } from '@/data/site';
import { buttonVariants } from '@/components/ui/button';

interface Props {
  heading?: string;
  body?: string;
  /** Overrides the clinic-wide Jane App link for a service or practitioner. */
  bookingUrl?: string;
}

const {
  heading = 'Ready to Book?',
  body = 'Use our convenient online booking tool, or get in touch with our reception desk to schedule an appointment with any of our practitioners.',
  bookingUrl = SITE.bookingUrl,
} = Astro.props;
---

<!-- Surface rather than the soft-green plate: the outline button's green label
     only reaches 3.9:1 on that plate, which fails AA at this text size. -->
<section class="border-y border-border bg-surface py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="reveal text-3xl md:text-4xl">{heading}</h2>
    <p class="reveal reveal-delay-1 mt-5 text-lg leading-relaxed text-muted-foreground">
      {body}
    </p>
    <div class="reveal reveal-delay-2 mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href={bookingUrl}
        target="_blank"
        rel="noopener"
        class={buttonVariants({ size: 'lg' })}
      >
        Book Now
      </a>
      <a href="/contact" class={buttonVariants({ variant: 'secondary', size: 'lg' })}>
        Contact Us
      </a>
    </div>
  </div>
</section>
