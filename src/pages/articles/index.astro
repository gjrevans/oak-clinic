---
import ArticleCard from '@/components/ArticleCard.astro';
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHero from '@/components/PageHero.astro';
import { getPerson } from '@/data/people';
import { SITE } from '@/data/site';
import { STATIC_IMAGES } from '@/data/static-images';
import { getArticles } from '@/lib/articles';
import { breadcrumbSchema, collectionPageSchema } from '@/lib/schema';

const title = 'Articles';
const lede =
  'Check out our latest articles, blogs and guest posts to stay informed and up to date with what is going on at Oak Clinic.';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Articles', href: '/articles' },
];

const articles = await getArticles();

const cards = articles.map((article) => ({
  article,
  author: getPerson(article.data.author),
}));
---

<Base
  title={title}
  description={lede}
  schema={[collectionPageSchema(title, lede, '/articles'), breadcrumbSchema(crumbs)]}
>
  <PageHero
    title={title}
    description={lede}
    image={STATIC_IMAGES.articles.hero}
    cta={{ label: 'Book Now', href: SITE.bookingUrl }}
  />

  <div class="border-b border-hairline bg-surface">
    <Breadcrumb crumbs={crumbs} class="mx-auto max-w-7xl px-6 py-3" />
  </div>

  <section class="bg-background py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-10 max-w-xl">
        <label for="article-search" class="sr-only">Search articles</label>
        <div class="relative">
          <svg
            class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.2-3.2"></path>
          </svg>
          <input
            id="article-search"
            type="search"
            placeholder="Search articles"
            autocomplete="off"
            class="h-11 w-full rounded-full border border-hairline bg-card pl-11 pr-11 text-[0.9375rem] text-foreground outline-none transition-colors placeholder:text-muted-foreground hover:border-primary focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-ring/50 [&::-webkit-search-cancel-button]:appearance-none"
          />
          <button
            id="article-search-clear"
            type="button"
            hidden
            aria-label="Clear search"
            class="absolute right-2 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-secondary hover:text-primary"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <p
          id="article-search-status"
          role="status"
          aria-live="polite"
          class="mt-3 text-sm text-muted-foreground"
        >
          {articles.length} articles
        </p>
      </div>

      <div id="article-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          cards.map(({ article, author }, index) => (
            <div
              class={`reveal reveal-delay-${(index % 3) + 1}`}
              data-slug={article.data.slug}
              data-title={article.data.title}
              data-summary={article.data.summary}
              data-author={author?.name ?? ''}
            >
              <ArticleCard article={article} author={author} />
            </div>
          ))
        }
      </div>

      <div
        id="article-search-empty"
        hidden
        class="rounded-lg border border-hairline bg-card p-8 text-center"
      >
        <p class="text-lg">Nothing here matches that search.</p>
        <p class="mt-2 text-sm text-muted-foreground">
          Try a shorter word or a different spelling, or{' '}
          <button
            id="article-search-reset"
            type="button"
            class="text-primary underline underline-offset-4 transition-colors hover:text-primary-hover"
          >
            clear search
          </button>{' '}
          to see all {articles.length} articles.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  type Entry = { slug: string; text: string };

  const input = document.querySelector<HTMLInputElement>('#article-search');
  const grid = document.querySelector<HTMLElement>('#article-grid');
  const status = document.querySelector<HTMLElement>('#article-search-status');
  const empty = document.querySelector<HTMLElement>('#article-search-empty');
  const clearButton = document.querySelector<HTMLElement>('#article-search-clear');
  const resetButton = document.querySelector<HTMLElement>('#article-search-reset');

  if (input && grid && status && empty) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-slug]'));
    const total = cards.length;
    // Body text arrives after the first keystroke, so the first filter pass runs
    // on the title, summary and author already in the DOM and widens later.
    let bodies: Record<string, string> | null = null;
    let requested = false;
    let timer = 0;

    const cardText = (card: HTMLElement) =>
      `${card.dataset.title ?? ''} ${card.dataset.summary ?? ''} ${card.dataset.author ?? ''}`.toLowerCase();

    const loadIndex = () => {
      if (requested) return;
      requested = true;
      fetch('/articles/search.json')
        .then((response) => response.json())
        .then((entries: Entry[]) => {
          bodies = Object.fromEntries(entries.map((entry) => [entry.slug, entry.text]));
          filter(input.value);
        })
        .catch(() => {
          requested = false;
        });
    };

    const filter = (query: string) => {
      // A term has to start a word, so "iron" finds "iron-rich" but not "environment".
      const patterns = query
        .toLowerCase()
        .split(/\s+/)
        .filter((term) => term.length > 1)
        .map((term) => new RegExp(`(^|[^a-z0-9])${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`));
      let matches = 0;

      for (const card of cards) {
        const haystack = `${cardText(card)} ${bodies?.[card.dataset.slug ?? ''] ?? ''}`;
        const hit = patterns.every((pattern) => pattern.test(haystack));
        card.hidden = !hit;
        if (hit) matches += 1;
      }

      status.textContent = !patterns.length
        ? `${total} articles`
        : matches
          ? `${matches} of ${total} articles match`
          : `No articles match “${query.trim()}”`;
      empty.hidden = Boolean(!patterns.length || matches);
      if (clearButton) clearButton.hidden = query.length === 0;
    };

    const syncUrl = (query: string) => {
      const url = new URL(window.location.href);
      if (query.trim()) url.searchParams.set('q', query.trim());
      else url.searchParams.delete('q');
      history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
    };

    const clearSearch = () => {
      input.value = '';
      filter('');
      syncUrl('');
      input.focus();
    };

    input.addEventListener('input', () => {
      loadIndex();
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        filter(input.value);
        syncUrl(input.value);
      }, 80);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') clearSearch();
    });

    clearButton?.addEventListener('click', clearSearch);
    resetButton?.addEventListener('click', clearSearch);

    const initial = new URL(window.location.href).searchParams.get('q');
    if (initial) {
      input.value = initial;
      filter(initial);
      loadIndex();
    }
  }
</script>
