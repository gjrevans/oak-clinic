---
import Base from '@/layouts/Base.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import DisciplineAccordion from '@/components/DisciplineAccordion.astro';
import PageHero from '@/components/PageHero.astro';
import PractitionerCard from '@/components/PractitionerCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { buttonVariants } from '@/components/ui/button';
import { DISCIPLINES_BY_ORDER } from '@/data/disciplines';
import { FEATURED_PEOPLE, getPerson } from '@/data/people';
import { SITE, formatHours } from '@/data/site';
import { STATIC_IMAGES } from '@/data/static-images';
import { getFeaturedArticles } from '@/lib/articles';

const featuredArticles = await getFeaturedArticles();
const partnerLogo = STATIC_IMAGES.partner.logo;
const partnerPhoto = STATIC_IMAGES.partner.photo;
---

<Base title="Home">
  <PageHero title={SITE.tagline} image={STATIC_IMAGES.home.hero} />

  <section class="py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-8 px-6 md:grid-cols-3">
      <div class="reveal rounded-lg border border-hairline bg-card p-7">
        <h2 class="text-xl">Our Mission</h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          We are committed to using evidence-based medicine and collaborative care to help identify and treat the root cause of your health concerns, optimizing your wellbeing.
        </p>
      </div>

      <div class="reveal reveal-delay-1 flex flex-col rounded-lg border border-hairline bg-card p-7">
        <h2 class="text-xl">Appointments</h2>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Use our convenient online booking tool, or get in touch with our reception desk to schedule appointments with any of our practitioners.
        </p>
        <div class="mt-auto pt-6">
          <a
            href={SITE.bookingUrl}
            target="_blank"
            rel="noopener"
            class={buttonVariants({ className: 'w-full' })}
          >
            Book Now
          </a>
        </div>
      </div>

      <div class="reveal reveal-delay-2 rounded-lg border border-hairline bg-card p-7">
        <h2 class="text-xl">Hours of Operation</h2>
        <table class="mt-4 w-full text-left">
          <caption class="sr-only">Clinic opening hours</caption>
          <tbody class="text-muted-foreground">
            {
              SITE.hours.map((entry) => (
                <tr class="border-b border-hairline last:border-0">
                  <th scope="row" class="py-2 font-medium text-foreground">
                    {entry.day}
                  </th>
                  <td class="py-2 text-right">{formatHours(entry)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <SectionHeading
        title="Clinical Focus"
        lede="Oak Clinic whole-heartedly welcomes any and all health concerns. Some of our practitioners do however have a focus in the following areas."
        class="reveal"
      />
      <DisciplineAccordion
        disciplines={DISCIPLINES_BY_ORDER}
        class="reveal reveal-delay-1 mx-auto mt-12 max-w-4xl"
      />
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="reveal text-3xl md:text-4xl">About Us</h2>
      <p class="reveal reveal-delay-1 mt-5 text-lg leading-relaxed text-muted-foreground">
        Oak Clinic is a general, Naturopathic, family clinic located in Dawson Creek, British Columbia. We offer a variety of products and services to provide you with effective treatments for your unique healthcare care needs. We currently offer Naturopathic Consultations, Pharmaceuticals, Acupuncture, Cold Laser Therapy, Lab Testing and Massage Therapy. Come visit us in-clinic to browse our wide selection of professional grade supplements, personalized botanical prescriptions and medicinal teas.
      </p>
      <div class="reveal reveal-delay-2 mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href={SITE.bookingUrl}
          target="_blank"
          rel="noopener"
          class={buttonVariants({ size: 'lg' })}
        >
          Book Now
        </a>
        <a href="/contact" class={buttonVariants({ variant: 'secondary', size: 'lg' })}>
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <SectionHeading
        title="Our Practitioners"
        lede="Meet our growing team of care practitioners."
        class="reveal"
      />
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          FEATURED_PEOPLE.map((person, i) => (
            <PractitionerCard
              person={person}
              class={`reveal reveal-delay-${Math.min(i + 1, 5)}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="reveal overflow-hidden rounded-lg border border-hairline bg-card">
        <div class="grid items-center gap-10 p-8 md:grid-cols-2 md:gap-14 md:p-12">
          <div>
            <p class="text-sm font-medium tracking-[0.18em] text-muted-foreground uppercase">
              Introducing
            </p>
            <img
              src={partnerLogo.src}
              alt={SITE.partner.name}
              width={partnerLogo.width}
              height={partnerLogo.height}
              loading="lazy"
              decoding="async"
              class="mt-4 h-12 w-auto max-w-[18rem] object-contain object-left"
            />
            <p class="mt-3 flex items-center gap-2 text-sm font-medium tracking-[0.18em] text-primary uppercase">
              <span class="h-px w-5 bg-primary" aria-hidden="true"></span>
              By Oak Clinic
            </p>
            <p class="mt-6 text-xl leading-snug font-normal text-foreground md:text-2xl">
              Personalized meal plans, built by clinicians for real life.
            </p>
            <div class="prose-oak mt-5">
              <p>
                After years in practice, Dr. Ayla and Dr. Elena kept seeing the same pattern: nutrition is one of the most powerful tools for health, and one of the hardest for patients to follow long-term. Building a real plan that fits each patient's goals, life, and schedule has never been realistic in a clinic visit. With Framework Nutrition, now it is.
              </p>
              <p>
                Every plan is tailored to your health focus, goals, allergies, and preferences, then reviewed and approved by a licensed practitioner before it reaches you.
              </p>
              <p>Oak Clinic patients <strong>save 20% on their first plan</strong>.</p>
            </div>
            <div class="mt-8 flex flex-wrap gap-4">
              <a
                href={SITE.partner.signupUrl}
                target="_blank"
                rel="noopener"
                class={buttonVariants()}
              >
                Claim 20% Off
              </a>
              <a
                href={SITE.partner.aboutUrl}
                target="_blank"
                rel="noopener"
                class={buttonVariants({ variant: 'secondary' })}
              >
                Read Our Story
              </a>
            </div>
          </div>
          <div>
            <img
              src={partnerPhoto.src}
              alt={partnerPhoto.alt}
              width={partnerPhoto.width}
              height={partnerPhoto.height}
              loading="lazy"
              decoding="async"
              class="h-auto w-full"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    featuredArticles.length > 0 && (
      <section class="border-t border-border bg-surface py-16 md:py-24">
        <div class="mx-auto max-w-7xl px-6">
          <SectionHeading
            title="Recent Articles"
            lede="Keep up to date with the here and now at Oak Clinic as we post interesting information and articles from time to time."
            class="reveal"
          />
          <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {featuredArticles.map((article, i) => (
              <ArticleCard
                article={article}
                author={getPerson(article.data.author)}
                class={`reveal reveal-delay-${Math.min(i + 1, 5)}`}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
