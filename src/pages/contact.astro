---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHero from '@/components/PageHero.astro';
import { buttonVariants } from '@/components/ui/button';
import { SITE, addressLine, formatHours } from '@/data/site';
import { STATIC_IMAGES } from '@/data/static-images';
import { breadcrumbSchema, contactPageSchema } from '@/lib/schema';

const title = 'Contact Us';
const lede =
  "Get in touch to learn more about Oak Clinic's services, supplements and products, to book an appointment or just to say hello. We are happy to answer any questions or concerns.";

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact' },
];

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${SITE.name}, ${addressLine()}`)}&output=embed`;
---

<Base
  title={title}
  description={lede}
  schema={[contactPageSchema(), breadcrumbSchema(crumbs)]}
>
  <PageHero
    title={title}
    description={lede}
    image={STATIC_IMAGES.contact.hero}
    cta={{ label: 'Book Now', href: SITE.bookingUrl }}
  />

  <div class="border-b border-hairline bg-surface">
    <Breadcrumb crumbs={crumbs} class="mx-auto max-w-7xl px-6 py-3" />
  </div>

  <section class="bg-background py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 md:grid-cols-3 md:gap-10">
      <div class="reveal">
        <h2 class="text-2xl">Address</h2>
        <p class="mt-5 leading-relaxed text-muted-foreground">
          {SITE.address.street}<br />
          {SITE.address.city}, {SITE.address.region}, {SITE.address.postalCode}, Canada
        </p>
        <a
          href={SITE.mapUrl}
          target="_blank"
          rel="noopener"
          class={buttonVariants({ className: 'mt-7' })}
        >
          Get Directions
        </a>
      </div>

      <div class="reveal reveal-delay-1 md:border-x md:border-hairline md:px-10">
        <h2 class="text-2xl">Hours</h2>
        <table class="mt-5 w-full max-w-xs text-left">
          <tbody>
            {
              SITE.hours.map((entry) => (
                <tr>
                  <th scope="row" class="py-1.5 pr-6 font-medium">
                    {entry.day}
                  </th>
                  <td class="py-1.5 text-muted-foreground">{formatHours(entry)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="reveal reveal-delay-2">
        <h2 class="text-2xl">Contact</h2>
        <ul class="mt-5 space-y-4">
          <li class="flex items-center gap-3">
            <svg
              class="h-4 w-4 shrink-0 text-primary"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1l-2.22 2.23Z"
              ></path>
            </svg>
            <a href={SITE.phoneHref} class="transition-colors hover:text-primary">{SITE.phone}</a>
          </li>
          <li class="flex items-center gap-3">
            <svg
              class="h-4 w-4 shrink-0 text-primary"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-2.95a15.6 15.6 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8ZM12 4.05c.67.97 1.2 2.05 1.56 3.2h-3.12c.36-1.15.89-2.23 1.56-3.2ZM4.26 14a7.9 7.9 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26Zm.84 2h2.95c.33 1.28.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16Zm2.95-8H5.1a8 8 0 0 1 4.35-3.6A15.6 15.6 0 0 0 8.05 8ZM12 19.95c-.67-.97-1.2-2.05-1.56-3.2h3.12c-.36 1.15-.89 2.23-1.56 3.2ZM14.02 14H9.98a14.6 14.6 0 0 1 0-4h4.04a14.6 14.6 0 0 1 0 4Zm.53 5.6c.6-1.1 1.07-2.32 1.4-3.6h2.95a8 8 0 0 1-4.35 3.6Zm1.81-5.6a16.5 16.5 0 0 0 0-4h3.38a7.9 7.9 0 0 1 0 4h-3.38Z"
              ></path>
            </svg>
            <a href={SITE.tollFreeHref} class="transition-colors hover:text-primary">
              {SITE.tollFree}
            </a>
          </li>
          <li class="flex items-center gap-3">
            <svg
              class="h-4 w-4 shrink-0 text-primary"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.2 7.2-4.4H4.8L12 12.2Zm0 2.3L4 9.6V17h16V9.6l-8 4.9Z"
              ></path>
            </svg>
            <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-primary">
              {SITE.email}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="reveal overflow-hidden rounded-2xl border border-hairline bg-card">
        <iframe
          src={mapSrc}
          title={`Map showing ${SITE.name} at ${addressLine()}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-[24rem] w-full border-0 md:h-[28rem]"></iframe>
      </div>
    </div>
  </section>
</Base>
