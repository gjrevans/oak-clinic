---
import ArticleCard from '@/components/ArticleCard.astro';
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { buttonVariants } from '@/components/ui/button';
import { getDiscipline } from '@/data/disciplines';
import { getService } from '@/data/services';
import { SITE } from '@/data/site';
import type { Person } from '@/data/types';
import { getArticlesByAuthor } from '@/lib/articles';
import { displaySummary } from '@/lib/people';
import { breadcrumbSchema, personSchema } from '@/lib/schema';

interface Props {
  person: Person;
}

const { person } = Astro.props;

const summary = displaySummary(person);
const portrait = person.mainImage ?? person.thumbnailImage;

// Some rows still point at a discipline or service that has since been
// archived, so a miss drops the pill rather than linking into a 404.
const servicePills = person.services
  .map((slug) => getService(slug))
  .filter((service) => service !== undefined)
  .map((service) => ({ name: service.name, href: `/services/${service.slug}` }));

const disciplinePills = person.disciplines
  .map((slug) => getDiscipline(slug))
  .filter((discipline) => discipline !== undefined)
  .map((discipline) => ({ name: discipline.name, href: `/disciplines/${discipline.slug}` }));

const bookingHref = person.bookingLink || SITE.bookingUrl;

const articles = await getArticlesByAuthor(person.slug);

const firstSentence = (html: string) => {
  const plain = html
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();
  const match = plain.match(/^.*?[.!?](?=\s|$)/);
  return (match ? match[0] : plain).slice(0, 300);
};

const description =
  summary ?? (person.description ? firstSentence(person.description) : `${person.name}, ${person.title} at ${SITE.name}.`);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Team', href: '/team' },
  { name: person.name, href: `/people/${person.slug}` },
];
---

<Base
  title={person.name}
  description={description}
  ogImage={portrait?.src}
  schema={[personSchema(person), breadcrumbSchema(crumbs)]}
>
  <div class="border-b border-hairline bg-surface">
    <Breadcrumb crumbs={crumbs} class="mx-auto max-w-7xl px-6 py-3" />
  </div>

  <section class="bg-background py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-14">
      {
        portrait && (
          <div class="reveal oak-frame self-start border border-hairline bg-surface md:sticky md:top-28">
            <img
              src={portrait.src}
              alt={portrait.alt || person.name}
              width={portrait.width}
              height={portrait.height}
              loading="lazy"
              decoding="async"
              class="w-full object-cover"
            />
          </div>
        )
      }

      <div class="reveal reveal-delay-1">
        <h1 class="text-[2rem] leading-10 md:text-5xl md:leading-[3.5rem]">{person.name}</h1>
        <p class="mt-3 text-sm font-medium tracking-wide text-primary">{person.title}</p>

        {
          (servicePills.length > 0 || disciplinePills.length > 0) && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {servicePills.map((pill) => (
                <li>
                  <a
                    href={pill.href}
                    class="inline-flex rounded-full bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary-hover"
                  >
                    {pill.name}
                  </a>
                </li>
              ))}
              {disciplinePills.map((pill) => (
                <li>
                  <a
                    href={pill.href}
                    class="inline-flex rounded-full bg-accent px-3.5 py-1.5 text-xs font-semibold text-accent-foreground transition-colors hover:bg-surface-strong"
                  >
                    {pill.name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        {person.description && <div class="prose-oak mt-8" set:html={person.description} />}

        {
          person.quote && (
            <blockquote class="mt-8 rounded-lg border-l-4 border-primary bg-surface p-6 text-lg leading-relaxed text-foreground">
              {person.quote}
            </blockquote>
          )
        }

        {
          person.bookingText && (
            <div
              class="prose-oak mt-8 rounded-lg border border-hairline bg-surface p-5 text-[0.9375rem]"
              set:html={person.bookingText}
            />
          )
        }

        {
          person.bookable && (
            <a
              href={bookingHref}
              target="_blank"
              rel="noopener"
              class={buttonVariants({ size: 'lg', className: 'mt-8' })}
            >
              Book Now
            </a>
          )
        }
      </div>
    </div>
  </section>

  {
    articles.length > 0 && (
      <section class="border-t border-border bg-surface py-16 md:py-24">
        <div class="mx-auto max-w-7xl px-6">
          <SectionHeading
            title={`Recent Articles By ${person.name}`}
            lede="Keep up to date with the here and now at Oak Clinic as we post interesting information and articles from time to time."
            class="reveal"
          />
          <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {articles.map((article, index) => (
              <ArticleCard
                article={article}
                author={person}
                class={`reveal reveal-delay-${Math.min(index + 1, 5)}`}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
