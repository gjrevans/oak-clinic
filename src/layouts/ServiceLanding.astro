---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import { SITE } from '@/data/site';
import type { Service } from '@/data/types';
import { breadcrumbSchema, serviceSchema } from '@/lib/schema';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const bookingHref = service.bookingLink || SITE.bookingUrl;
// The live hero prints the Meta Description, not the rich-text description;
// the latter is what the services index cards carry.
const lede = service.metaDescription;
// Rows with neither a heading nor a body are unfilled Webflow slots.
const sections = service.sections.filter((section) => section.title || section.html);

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: service.name, href: `/services/${service.slug}` },
];
---

<Base
  title={service.metaTitle ?? service.name}
  description={service.metaDescription}
  schema={[serviceSchema(service), breadcrumbSchema(crumbs)]}
>
  <PageHero
    title={service.name}
    description={lede}
    image={service.heroImage}
    cta={{ label: 'Book Now', href: bookingHref }}
  />

  {
    service.bookingText && (
      <div class="border-b border-border bg-accent text-accent-foreground">
        <div
          class="mx-auto max-w-7xl px-6 py-4 text-sm leading-relaxed [&>*+*]:mt-2 [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-4"
          set:html={service.bookingText}
        />
      </div>
    )
  }

  <div class="border-b border-border bg-surface">
    <Breadcrumb crumbs={crumbs} class="mx-auto max-w-7xl px-6 py-4" />
  </div>

  {
    sections.length > 0 ? (
      sections.map((section, i) => (
        <section
          class:list={[
            'py-16 md:py-24',
            i % 2 === 1 ? 'bg-surface' : 'bg-background',
          ]}
        >
          <div class="mx-auto grid max-w-7xl items-start gap-10 px-6 md:grid-cols-3 md:gap-14">
            {section.image && (
              <div
                class:list={[
                  'reveal oak-frame self-start border border-hairline bg-surface',
                  i % 2 === 1 && 'md:order-2',
                ]}
              >
                <img
                  src={section.image.src}
                  alt={section.image.alt || section.title}
                  width={section.image.width}
                  height={section.image.height}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div
              class:list={[
                'reveal reveal-delay-1',
                section.image ? 'md:col-span-2' : 'md:col-span-3',
              ]}
            >
              {section.title && <h2 class="text-2xl md:text-3xl">{section.title}</h2>}
              {section.html && <div class="prose-oak mt-5" set:html={section.html} />}
            </div>
          </div>
        </section>
      ))
    ) : (
      <section class="py-16 md:py-24">
        <div class="mx-auto max-w-3xl px-6">
          <p class="reveal text-lg leading-relaxed text-muted-foreground">
            {service.name} is offered within an acupuncture appointment at Oak Clinic rather than booked on its own. Your acupuncturist will discuss whether it suits your treatment plan. <a class="font-medium text-primary underline underline-offset-4 hover:text-primary-hover" href="/services/acupuncture">Read about acupuncture appointments</a> to see what a session includes.
          </p>
        </div>
      </section>
    )
  }

  {
    service.callToAction && (
      <section class="bg-accent py-14 text-accent-foreground md:py-16">
        <div class="mx-auto max-w-3xl px-6 text-center">
          <div
            class="reveal text-lg leading-relaxed [&>*+*]:mt-4 [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-4"
            set:html={service.callToAction}
          />
        </div>
      </section>
    )
  }

  <CtaBand bookingUrl={bookingHref} />
</Base>
